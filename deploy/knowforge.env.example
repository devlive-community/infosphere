# 复制完整内容到 GitHub Actions secret INFO_SPHERE_ENV_FILE。
# 生成强随机密钥：openssl rand -hex 32

# Go API
INFO_SPHERE_DATA=/var/lib/infosphere
INFO_SPHERE_PORT=6969

# 只有这些反向代理可提供真实客户端 IP；本机 nginx 使用回环地址。
INFO_SPHERE_TRUSTED_PROXIES=127.0.0.1,::1

# 站点对外地址（sitemap / canonical 用；nginx 设置 X-Forwarded-Host 后通常无需再配）
INFO_SPHERE_SITE_URL=https://infosphere.devlive.org

# Next.js SSR 由 Go 二进制在内部启动，通常无需额外配置端口。
# INFO_SPHERE_WEB_PORT=6900

# 在线升级：升级源仓库（默认 devlive-community/infosphere）
# INFO_SPHERE_UPSTREAM_REPO=devlive-community/infosphere
