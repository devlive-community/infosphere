# InfoSphere 生产站点 nginx 配置示例。
#
# 架构：nginx (:80/:443) → Next.js SSR (:6900) 页面渲染
#                       → Go API (:6969)     /api /uploads /health
#
# TLS：DNS 指向服务器后执行一次即可自动签发并配置 80→443 跳转：
#   sudo certbot --nginx -d infosphere.devlive.org
# 证书自动续期由 certbot.timer 负责。

server {
    listen 80;
    listen [::]:80;
    server_name infosphere.devlive.org 43.162.108.186;
    client_max_body_size 12m;

    # Go API 与上传文件
    location /api/ {
        proxy_pass http://127.0.0.1:6969;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /uploads/ {
        proxy_pass http://127.0.0.1:6969;
        proxy_set_header Host $host;
    }
    location = /health {
        proxy_pass http://127.0.0.1:6969;
    }

    # Next.js 静态资源：优先读累积式共享目录（跨版本保留旧 chunk，
    # 已打开的旧页面不会因部署而 404），缺失时回退到应用服务
    location /_next/static/ {
        alias /var/www/infosphere/static/;
        try_files $uri @next_static;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location @next_static {
        proxy_pass http://127.0.0.1:6900;
    }

    # 页面与其他资源：Next.js SSR
    location / {
        proxy_pass http://127.0.0.1:6900;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
