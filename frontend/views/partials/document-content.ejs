<div class="mx-auto">
    <div class="bg-white rounded-lg p-6 w-full max-w-md">
        <h3 class="text-lg font-medium text-gray-900 mb-4">新建文档</h3>
        <form method="POST" action="/document/writer/<%= book.username %>/<%= book.slug %>">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">文档标题</label>
                <input type="text"
                       name="title"
                       id="newDocTitle"
                       class="w-96 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="请输入文档标题"
                       required>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">文档路径</label>
                <input type="text"
                       name="doc_slug"
                       id="newDocSlug"
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="document-slug"
                       required>
                <p class="text-xs text-gray-500 mt-1">URL友好的路径，只能包含字母、数字和连字符</p>
            </div>
            <div class="flex justify-end space-x-3">
                <button type="button" class="px-4 py-2 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors" onclick="closeModal('newDocumentModal')">
                    取消
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-md transition-colors">
                    创建
                </button>
            </div>
        </form>
    </div>
</div>