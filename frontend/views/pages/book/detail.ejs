<%- include('../../layouts/base/header', { title: book.title }) %>

<div class="min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-4 md:gap-8 max-w-7xl mx-auto">
            <div class="lg:w-80 flex-shrink-0">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <!-- 封面图片 -->
                    <div class="text-center mb-6">
                        <% if (book.cover_image) { %>
                            <div class="relative group">
                                <img src="<%= book.cover_image %>"
                                     alt="<%= book.title %>"
                                     class="w-full max-w-xs mx-auto rounded-xl shadow-lg group-hover:shadow-2xl transition-all duration-300 transform group-hover:scale-105">
                                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-5 rounded-xl transition-all duration-300"></div>
                            </div>
                        <% } else { %>
                            <div class="w-full max-w-xs mx-auto bg-gradient-to-br from-gray-100 via-gray-50 to-gray-100 h-80 border-2 border-dashed border-gray-300 rounded-xl flex items-center justify-center">
                                <div class="text-center">
                                    <i class="fas fa-book text-gray-400 text-4xl mb-3"></i>
                                    <p class="text-gray-500 text-sm">暂无封面</p>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- 基本信息 -->
                    <div class="space-y-6">
                        <div class="border-b border-gray-100 pb-4">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">作者</h3>
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                            <i class="fas fa-user text-blue-600 text-sm"></i>
                                        </div>
                                        <span class="text-gray-900 font-medium"><%= book.username || '未知作者' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="border-b border-gray-100 pb-4">
                            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">发布时间</h3>
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                    <i class="fas fa-calendar text-green-600 text-sm"></i>
                                </div>
                                <span class="text-gray-900 font-medium"><%= book.created_at %></span>
                            </div>
                        </div>

                        <div class="border-b border-gray-100 pb-4">
                            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">状态</h3>
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                    <i class="fas fa-circle text-purple-600 text-sm"></i>
                                </div>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                                    <% if (book.status === 'published') { %>bg-green-100 text-green-800
                                    <% } else if (book.status === 'draft') { %>bg-yellow-100 text-yellow-800
                                    <% } else { %>bg-gray-100 text-gray-800<% } %>">
                                    <% if (book.status === 'published') { %>
                                        <i class="fas fa-check-circle mr-1"></i>已发布
                                    <% } else if (book.status === 'draft') { %>
                                        <i class="fas fa-edit mr-1"></i>草稿
                                    <% } else { %>
                                        <i class="fas fa-archive mr-1"></i>已归档
                                    <% } %>
                                </span>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">可见性</h3>
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 <%= book.is_public ? 'bg-blue-100' : 'bg-gray-100' %> rounded-full flex items-center justify-center">
                                    <i class="<%= book.is_public ? 'fas fa-globe text-blue-600' : 'fas fa-lock text-gray-600' %> text-sm"></i>
                                </div>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                                    <% if (book.is_public) { %>bg-blue-100 text-blue-800<% } else { %>bg-gray-100 text-gray-800<% } %>">
                                    <%= book.is_public ? '公开访问' : '私有访问' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- 操作按钮 -->
                    <div class="mt-8 space-y-3">
                        <% if (user && user.id === book.user_id) { %>
                            <%- include('../../components/button', { href: `/book/${book.slug}/edit`, text: '编辑书籍', icon: 'fas fa-edit', className: 'w-full' }) %>
                        <% } %>

                        <% if (user && user.id === book.user_id) { %>
                            <form action="/book/<%= book.slug %>" method="POST">
                                <input type="hidden" name="_method" value="DELETE">
                                <%- include('../../components/button', { type: 'submit', variant: 'danger', icon: 'fas fa-trash', text: '删除书籍', className: 'w-full' }) %>
                            </form>
                        <% } %>

                        <%- include('../../components/button', { onclick: 'shareBook()', text: '分享书籍', icon: 'fas fa-share-alt', variant: 'outline', className: 'w-full' }) %>
                    </div>
                </div>
            </div>

            <div class="flex-1 space-y-4">
                <!-- 标题和描述 -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <div class="mb-6">
                        <h1 class="text-4xl font-bold text-gray-900 mb-4 leading-tight"><%= book.title %></h1>

                        <!-- 元数据标签 -->
                        <div class="flex flex-wrap items-center gap-4 text-sm">
                            <div class="flex items-center space-x-2 text-gray-600">
                                <i class="fas fa-user text-blue-500"></i>
                                <span>由 <span class="font-medium text-gray-900"><%= book.username || '匿名用户' %></span> 分享</span>
                            </div>

                            <div class="flex items-center space-x-2 text-gray-600">
                                <i class="fas fa-eye text-green-500"></i>
                                <span><span class="font-medium text-gray-900"><%= book.view_count || 0 %></span> 次查看</span>
                            </div>

                            <% if (book.slug) { %>
                                <div class="flex items-center space-x-2 bg-gray-100 text-gray-700 px-3 py-1 rounded-full">
                                    <i class="fas fa-link text-indigo-500"></i>
                                    <span class="font-mono text-sm">/book/<%= book.slug %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- 内容简介 -->
                    <% if (book.description) { %>
                        <div class="prose max-w-none">
                            <div class="border-l-4 border-blue-500 pl-6">
                                <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
                                    <i class="fas fa-book-open text-blue-500 mr-2"></i>
                                    内容简介
                                </h3>
                                <div class="text-gray-700 leading-relaxed text-lg whitespace-pre-wrap bg-gray-50 p-6 rounded-lg"><%= book.description %></div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-center py-16 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                            <div class="max-w-sm mx-auto">
                                <i class="fas fa-file-text text-gray-400 text-5xl mb-4"></i>
                                <h3 class="text-lg font-medium text-gray-900 mb-2">暂无内容简介</h3>
                                <p class="text-gray-500">作者还没有添加这本书的简介信息</p>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- 统计信息卡片 -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                        <i class="fas fa-chart-bar text-indigo-500 mr-2"></i>
                        阅读统计
                    </h3>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                        <div class="text-center">
                            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-eye text-blue-600"></i>
                            </div>
                            <div class="text-2xl font-bold text-gray-900"><%= book.view_count || 0 %></div>
                            <div class="text-sm text-gray-500">浏览次数</div>
                        </div>

                        <div class="text-center">
                            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-heart text-green-600"></i>
                            </div>
                            <div class="text-2xl font-bold text-gray-900">0</div>
                            <div class="text-sm text-gray-500">收藏次数</div>
                        </div>

                        <div class="text-center">
                            <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-share-alt text-purple-600"></i>
                            </div>
                            <div class="text-2xl font-bold text-gray-900">0</div>
                            <div class="text-sm text-gray-500">分享次数</div>
                        </div>

                        <div class="text-center">
                            <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-2">
                                <i class="fas fa-clock text-yellow-600"></i>
                            </div>
                            <div class="text-2xl font-bold text-gray-900">刚刚</div>
                            <div class="text-sm text-gray-500">最后更新</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function shareBook() {
        if (navigator.share) {
            navigator.share({
                title: '<%= book.title %>',
                text: '<%= book.description ? book.description.substring(0, 100) + "..." : "推荐一本好书" %>',
                url: window.location.href
            })
        }
        else {
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('链接已复制到剪贴板')
            })
        }
    }
</script>

<%- include('../../layouts/base/footer') %>