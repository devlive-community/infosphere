<%- include('../../layouts/base/header', { title: '我的书籍' }) %>

<div class="min-h-screen py-4 md:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-4 md:gap-8 max-w-7xl mx-auto">
            <%- include('../../layouts/book/nav') %>

            <div class="flex-1">
                <div class="bg-white rounded-lg border mb-4 md:mb-6">
                    <div class="px-4 md:px-6 py-4 border-b border-gray-200">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h3 class="text-lg font-medium text-gray-900">我的书籍</h3>
                                <p class="mt-1 text-sm text-gray-500">管理您创建的所有书籍</p>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
                                <%- include('../../components/button', { href: '/book/create', size: 'sm', target: '_blank', text: '创建新书籍', icon: 'fas fa-plus', variant: 'primary', className: 'w-full sm:w-auto' }) %>
                            </div>
                        </div>
                    </div>

                    <div class="px-4 md:px-6 py-4">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div class="text-center">
                                <div class="text-xl md:text-2xl font-bold text-gray-900"><%= summary?.total_books %></div>
                                <div class="text-xs md:text-sm text-gray-500">总书籍数</div>
                            </div>
                            <div class="text-center">
                                <div class="text-xl md:text-2xl font-bold text-green-600">
                                    <%= summary?.published_count %>
                                </div>
                                <div class="text-xs md:text-sm text-gray-500">已发布</div>
                            </div>
                            <div class="text-center">
                                <div class="text-xl md:text-2xl font-bold text-yellow-600">
                                    <%= summary?.draft_count %>
                                </div>
                                <div class="text-xs md:text-sm text-gray-500">草稿</div>
                            </div>
                            <div class="text-center">
                                <div class="text-xl md:text-2xl font-bold text-blue-600">
                                    <%= summary?.total_views %>
                                </div>
                                <div class="text-xs md:text-sm text-gray-500">总浏览量</div>
                            </div>
                        </div>

                        <% if (pagination) { %>
                            <div class="mt-4 text-center text-sm text-gray-500 <%= pagination ? 'border-t border-gray-100 pt-4' : '' %>">
                                <%- include('../../components/pagination-info', { pagination: pagination }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="space-y-4 md:space-y-6">
                    <% if (data && data.length > 0) { %>
                        <% data.forEach(book => { %>
                            <div class="bg-white rounded-lg border hover:border-blue-300 transition-shadow duration-150">
                                <div class="p-4 md:p-6">
                                    <div class="flex flex-col sm:flex-row items-start space-y-4 sm:space-y-0 sm:space-x-4">
                                        <div class="flex-shrink-0 self-center sm:self-start">
                                            <% if (book.cover_image) { %>
                                                <img src="<%= book.cover_image %>"
                                                     alt="<%= book.title %>"
                                                     class="min-w-32 max-w-32 min-h-44 max-h-44 sm:w-16 sm:h-full object-cover rounded-lg shadow-sm">
                                            <% } else { %>
                                                <div class="min-w-32 max-w-32 min-h-44 max-h-44 sm:w-16 sm:h-full bg-gray-200 rounded-lg flex items-center justify-center">
                                                    <i class="fas fa-book fa-2x text-gray-400"></i>
                                                </div>
                                            <% } %>
                                        </div>

                                        <div class="flex-1 min-w-0 w-full sm:w-auto">
                                            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between space-y-3 sm:space-y-0 min-h-32">
                                                <div class="flex-1 space-y-3">
                                                    <h4 class="text-lg font-medium text-gray-900 break-words sm:truncate">
                                                        <a href="/book/info/<%= book.slug %>" class="hover:text-blue-600">
                                                            <%= book.title %>
                                                        </a>
                                                    </h4>

                                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
                                                        <span class="flex items-center">
                                                            <i class="fas fa-calendar mr-1"></i>
                                                            <%= book.created_at %>
                                                        </span>
                                                        <div class="flex items-center space-x-2 text-gray-600">
                                                            <i class="fas fa-eye text-green-500"></i>
                                                            <span><span class="font-medium text-gray-900"><%= book.view_count || 0 %></span> 次查看</span>
                                                        </div>
                                                        <div class="flex items-center space-x-2 bg-gray-100 text-gray-700 px-3 py-1 rounded-full">
                                                            <i class="fas fa-link text-indigo-500"></i>
                                                            <span class="font-mono text-sm">/book/<%= book.slug %></span>
                                                        </div>
                                                    </div>

                                                    <% if (book.description) { %>
                                                        <p class="text-sm text-gray-600 line-clamp-2 break-words">
                                                            <%= book.description.substring(0, 120) %><%= book.description.length > 120 ? '...' : '' %>
                                                        </p>
                                                    <% } else { %>
                                                        <p class="text-sm text-gray-400 italic">暂无描述</p>
                                                    <% } %>

                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                                            <% if (book.status === 'published') { %>bg-green-100 text-green-800
                                                            <% } else if (book.status === 'draft') { %>bg-yellow-100 text-yellow-800
                                                            <% } else { %>bg-gray-100 text-gray-800<% } %>">
                                                            <% if (book.status === 'published') { %>
                                                                <i class="fas fa-check-circle mr-1"></i>已发布
                                                            <% } else if (book.status === 'draft') { %>
                                                                <i class="fas fa-edit mr-1"></i>草稿
                                                            <% } else { %>
                                                                <i class="fas fa-archive mr-1"></i>已归档
                                                            <% } %>
                                                        </span>

                                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                                            <% if (book.is_public) { %>bg-blue-100 text-blue-800<% } else { %>bg-gray-100 text-gray-800<% } %>">
                                                            <i class="<%= book.is_public ? 'fas fa-globe' : 'fas fa-lock' %> mr-1"></i>
                                                            <%= book.is_public ? '公开' : '私有' %>
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="flex flex-row sm:flex-col gap-2 sm:ml-4 sm:h-full sm:justify-center">
                                                    <%- include('../../components/button', { href: `/book/info/${book.slug}`, target: '_blank', text: '查看', icon: 'fas fa-eye', variant: 'outline', size: 'sm', className: 'flex-1 sm:flex-none' }) %>

                                                    <%- include('../../components/button', { href: `/book/${book.slug}/edit`, text: '编辑', icon: 'fas fa-edit', variant: 'primary', size: 'sm', className: 'flex-1 sm:flex-none' }) %>

                                                    <% if (user && user.id === book.user_id) { %>
                                                        <form action="/book/<%= book.slug %>" method="POST" class="flex-1 sm:flex-none">
                                                            <input type="hidden" name="_method" value="DELETE">
                                                            <%- include('../../components/button', { type: 'submit', variant: 'danger', icon: 'fas fa-trash', text: '删除', size: 'sm', className: 'w-full', onclick: 'return confirm("确定要删除这本书籍吗？此操作不可恢复。")' }) %>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center bg-white rounded-lg border py-12 px-4">
                            <div class="max-w-sm mx-auto">
                                <i class="fas fa-book text-gray-400 text-6xl mb-4"></i>
                                <h3 class="text-lg font-medium text-gray-900 mb-2">还没有书籍</h3>
                                <p class="text-gray-500 mb-6">开始创建您的第一本书籍吧</p>
                                <%- include('../../components/button', { href: '/book/create', text: '创建第一本书', icon: 'fas fa-plus' }) %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <% if (pagination?.totalItems > 0) { %>
                    <%- include('../../components/pagination', { pagination: pagination }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../../layouts/base/footer') %>