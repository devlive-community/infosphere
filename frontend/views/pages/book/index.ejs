<%- include('../../layouts/base/header', { title: '书籍列表' }) %>

<div class="min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 md:py-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-8">
            <% if (data && data.length > 0) { %>
                <% data.forEach(book => { %>
                    <div class="bg-white rounded-lg transition-all duration-300 border border-gray-100 overflow-hidden group">
                        <div class="relative">
                            <div class="aspect-[3/4] relative overflow-hidden">
                                <% if (book.cover_image) { %>
                                    <img src="<%= book.cover_image %>"
                                         alt="<%= book.title %>"
                                         class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-gray-100">
                                        <i class="fas fa-book text-gray-300 text-2xl md:text-4xl opacity-50"></i>
                                    </div>
                                <% } %>

                                <a href="/book/info/<%= book.slug %>">
                                    <div class="hidden md:flex absolute inset-0 bg-gray-700 bg-opacity-80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex-col justify-center items-center text-center p-4 lg:p-6">
                                        <div class="text-white font-bold text-sm mb-3 leading-tight">
                                            <%= book.title %>
                                        </div>
                                        <div class="flex flex-col space-y-2 text-xs lg:text-sm text-gray-300">
                                        <span class="flex items-center justify-center">
                                            <i class="fas fa-user mr-1"></i>
                                            <%= book.username || '匿名' %>
                                        </span>
                                            <span class="flex items-center justify-center">
                                            <i class="fas fa-eye mr-1"></i>
                                            <%= book.view_count || 0 %>
                                        </span>
                                        </div>
                                    </div>
                                </a>

                                <a href="/book/info/<%= book.slug %>" class="md:hidden absolute inset-0 z-10"></a>
                            </div>

                            <div class="md:hidden p-3">
                                <h3 class="text-sm font-medium text-gray-900 truncate mb-2">
                                    <%= book.title %>
                                </h3>
                                <div class="flex items-center justify-between text-xs text-gray-500">
                                    <span class="flex items-center truncate">
                                        <i class="fas fa-user mr-1 text-blue-500"></i>
                                        <%= book.username || '匿名' %>
                                    </span>
                                    <span class="flex items-center">
                                        <i class="fas fa-eye mr-1 text-green-500"></i>
                                        <%= book.view_count || 0 %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full">
                    <div class="bg-white rounded-lg border border-gray-100 py-12 md:py-16 text-center">
                        <div class="w-16 h-16 md:w-24 md:h-24 bg-gradient-to-br from-blue-100 to-purple-100 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6">
                            <i class="fas fa-book text-blue-500 text-2xl md:text-3xl"></i>
                        </div>
                        <h3 class="text-lg md:text-2xl font-bold text-gray-900 mb-2 md:mb-4">暂无书籍</h3>
                        <p class="text-gray-500 text-sm md:text-base">还没有任何书籍，快来创建第一本吧！</p>
                    </div>
                </div>
            <% } %>
        </div>

        <% if (pagination?.totalItems > 0) { %>
            <div class="mt-6 md:mt-8">
                <%- include('../../components/pagination', { pagination: pagination }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../../layouts/base/footer') %>