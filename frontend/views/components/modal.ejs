<!-- 通用模态框组件 -->
<div id="<%= modalId %>" style="margin-top: 0px;"
     class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded max-w-2xl mx-4 relative transform scale-90 transition-transform duration-300"
         id="<%= modalId %>Content">
        <!-- 关闭按钮 -->
        <button onclick="closeModal('<%= modalId %>')" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition-colors z-10">
            <i class="fas fa-circle-xmark"></i>
        </button>

        <!-- 模态框内容 -->
        <%- content %>
    </div>
</div>

<script>
    function showModal(modalId) {
        const modal = document.getElementById(modalId)
        const content = document.getElementById(modalId + 'Content')

        modal.classList.remove('opacity-0', 'invisible')
        content.classList.remove('scale-90')
        content.classList.add('scale-100')
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId)
        const content = document.getElementById(modalId + 'Content')

        content.classList.remove('scale-100')
        content.classList.add('scale-90')

        // 动画计时：等待变换完成后再隐藏
        setTimeout(() => {
            modal.classList.add('opacity-0', 'invisible')
        }, 200)
    }

    // ESC 键处理程序：关闭所有可见模态
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            const modals = document.querySelectorAll('[id$="Modal"]')
            modals.forEach(modal => {
                if (!modal.classList.contains('invisible')) {
                    closeModal(modal.id)
                }
            })
        }
    })
</script>