<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof title !== 'undefined' ? title : '') + (typeof site !== 'undefined' && site.name ? ' - ' + site.name : '') || 'InfoSphere' %></title>

    <!-- SEO 配置 -->
    <meta name="description" content="<%= typeof meta !== 'undefined' && meta.description ? meta.description : (typeof site !== 'undefined' && site.description ? site.description : '') %>">
    <meta name="keywords" content="<%= typeof meta !== 'undefined' && meta.keywords ? meta.keywords : (typeof site !== 'undefined' && site.keywords ? site.keywords : '') %>">
    <meta name="author" content="<%= typeof meta !== 'undefined' && meta.author ? meta.author : (typeof site !== 'undefined' && site.name ? site.name : '') %>">

    <!-- 浏览器相关配置 -->
    <link rel="icon" href="/images/logo.png" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <link rel="stylesheet" href="/css/infosphere.css"/>
    <link rel="stylesheet" href="/css/fontawesome.min.css"/>
</head>

<body class="bg-white min-h-screen flex flex-col">

<main class="flex-grow">